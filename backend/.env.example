# =================================================================
# Fieldnote Voice Recorder Backend Environment Configuration
# =================================================================

# 1. MongoDB connection string.
# Local: mongodb://localhost:27017/voiceRecorder
# Render / Atlas: paste the mongodb+srv URI into the service environment as MONGODB_URI.
# A value already set in the environment is kept. This file does not replace it.
MONGODB_URI=mongodb://localhost:27017/voiceRecorder

# 2. OpenAI API Key for Whisper Speech-to-Text Model (whisper-1)
OPENAI_API_KEY=sk-your-openai-api-key-here

# 3. Optional: Groq API Key for Whisper Large V3
GROQ_API_KEY=gsk_your_groq_api_key_here

# 4. Server Host & Port
HOST=0.0.0.0
PORT=8000

# 5. Postgres with pgvector. Started by backend/docker-compose.yml on port 5433.
PGVECTOR_URL=postgresql://wren:wren@127.0.0.1:5433/wren
